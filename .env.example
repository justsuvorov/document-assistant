# ── PATHS ────────────────────────────────────────────────────────────────────
NORMATIVE_BASE=/app/normative_base
EXAMPLES_PATH=/app/examples

# ── AI PROVIDER ───────────────────────────────────────────────────────────────
# Используется Qwen через OpenAI-compatible API
AI_TEMPERATURE=0.2

# ── Qwen Model (OpenAI-compatible API) ─────────────────────────────────────────
QWEN_API_URL=https://model-1.ai-api.vsk.ru/v1/completions
QWEN_MODEL_NAME=Qwen3.6-35B-A3B-NVFP4
QWEN_MAX_TOKENS=100000        # максимум токенов в ответе
QWEN_NUM_CTX=400000           # полное контекстное окно модели

# ── Обработка документов ───────────────────────────────────────────────────────
# Максимальное количество символов из клиентского файла
LLM_MAX_CHARS=2200000

# Максимум разделов нормативной базы в промте (RAG-лимит)
LLM_MAX_SECTIONS=300

# Максимум чанков для обработки (0 = без ограничений)
LLM_MAX_CHUNKS=0

# Строк в одном батче при разбивке таблицы
LLM_BATCH_SIZE=25

# ── ХРАНИЛИЩЕ ФАЙЛОВ ────────────────────────────────────────────────────────────
# Каталог на диске сервера. Внутри — {user_id}/{session_id}/input|output/.
# Должен быть доступен на запись и приложению, и воркеру (в compose — общий том).
STORAGE_DIR=/data

# ── БАЗА МЕТАДАННЫХ ────────────────────────────────────────────────────────────
# В compose — Postgres. Для запуска без Docker подойдёт:
#   DATABASE_URL=sqlite+aiosqlite:///./document_assistant.db
DATABASE_URL=postgresql+asyncpg://da:da@postgres:5432/document_assistant

# ── ОЧЕРЕДЬ ЗАДАЧ ──────────────────────────────────────────────────────────────
# Очередь — сама таблица sessions, отдельный брокер не нужен.
# Сколько документов воркер обрабатывает параллельно
WORKER_MAX_JOBS=2
# Потолок на одну обработку, секунды
WORKER_JOB_TIMEOUT=7200
# Как часто воркер заглядывает в БД за новой задачей, секунды
WORKER_POLL_INTERVAL=2
# Через сколько секунд задача в processing считается брошенной (упавший воркер)
# и возвращается в очередь. Должно быть заметно больше самой долгой обработки.
WORKER_STALE_TIMEOUT=10800
# Сколько попыток даётся задаче, прежде чем она признаётся ошибкой
WORKER_MAX_ATTEMPTS=3

# ── АВТОРИЗАЦИЯ (Keycloak / OIDC) ──────────────────────────────────────────────
# true — Keycloak не используется, все запросы идут от AUTH_DEV_USER_ID.
# Только для локальной разработки. В проде обязательно false.
AUTH_DISABLED=false
AUTH_DEV_USER_ID=dev-user

KEYCLOAK_URL=https://keycloak.example.ru
KEYCLOAK_REALM=corp
KEYCLOAK_CLIENT_ID=document-assistant
KEYCLOAK_CLIENT_SECRET=
# В Keycloak в настройках клиента должен быть разрешён redirect URI:
#   https://<хост-приложения>/auth/callback

# Секрет подписи cookie-сессии — в проде задать случайным значением
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=da_session
# true, если приложение работает по HTTPS
SESSION_COOKIE_SECURE=false

# ── PROMPT ─────────────────────────────────────────────────────────────────────
AI_ROLE=Ты — опытный специалист по страхованию. Твоя задача — точно сопоставить требования клиента с нормативными программами страхования и подготовить структурированный ответ.

AI_PROMPT_TEMPLATE={role}\n\n## НОРМАТИВНАЯ БАЗА (ПРОГРАММЫ СТРАХОВАНИЯ):\n{normative_base}\n\n## ПРИМЕРЫ ЭТАЛОННЫХ ОТВЕТОВ:\n{examples}\n\n## ЗАПРОС КЛИЕНТА:\n{source_text}\n\n## ЗАДАЧА:\n1. Из нормативной базы выбери программу страхования, наиболее соответствующую требованиям клиента.\n2. Для КАЖДОЙ строки из таблицы запроса клиента создай ровно одну строку в таблице ответа.\n   ВАЖНО: не объединяй строки, не пропускай строки, не добавляй лишние строки.\n   Количество строк в ответе должно строго совпадать с количеством строк в запросе.\n3. Для каждой строки укажи статус покрытия в выбранной программе:\n   - Есть — требование полностью покрывается программой\n   - Нет — требование отсутствует в программе\n   - Частично — требование покрывается частично (поясни в комментарии)\n4. Оформи ответ СРАЗУ в виде таблицы (без вводного текста и преамбулы) со столбцами:\n   | Требование клиента | Покрытие по программе | Статус | Комментарий |\n5. После таблицы добавь краткое резюме: выбранная программа, ключевые расхождения и рекомендации.\n\n## ОТВЕТ:
