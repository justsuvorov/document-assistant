# ── PATHS (для EXE, относительные) ────────────────────────────────────────────
NORMATIVE_BASE=./normative_base
EXAMPLES_PATH=./examples

# ── PATHS: сверка деклараций с ген. полисом (cargo, /api/reconcile) ────────────
RECONCILIATION_RULES_BASE=
SPECIAL_CONDITIONS_GLOBAL_PATH=\\fstorfs\disk_m\БОС_ФСЦ_УПиСД\ДГ\Информационный\ДпГ УПиСД ФСЦ.xlsm
# Формы ответа: пусто = встроенные копии, зашитые в EXE
RECONCILIATION_TEMPLATE_HORIZONTAL=
RECONCILIATION_TEMPLATE_VERTICAL=
DECLARATIONS_MONTH_FORMAT=%Y-%m

# ── AI PROVIDER ───────────────────────────────────────────────────────────────
# AI_PROVIDER: qwen (/v1/completions) | vsk (/v1/chat/completions)
AI_PROVIDER=qwen
AI_TEMPERATURE=0.2

# ── Qwen (используется для EXE) ────────────────────────────────────────────
QWEN_API_URL=https://model-1.ai-api.vsk.ru/v1/completions
QWEN_MODEL_NAME=Qwen3.6-35B-A3B-NVFP4
QWEN_MAX_TOKENS=100000
QWEN_NUM_CTX=500000

# ── VSK AI (chat/completions, альтернативный провайдер) ─────────────────────
VSK_API_URL=https://llm.ai-api.vsk.ru/v1/chat/completions
VSK_API_KEY=sk-egVSRehXexYw8EfV4bAUAQ
VSK_MODEL_NAME=Qwen3.6-35B-A3B-NVFP4
VSK_MAX_TOKENS=100000
VSK_THINKING_TOKEN_BUDGET=1000
VSK_NUM_CTX=500000

# ── Обработка документов ───────────────────────────────────────────────────────
LLM_MAX_CHARS=2200000
LLM_MAX_SECTIONS=300
LLM_MAX_CHUNKS=0
LLM_BATCH_SIZE=25
AI_TEMPERATURE=0.2

# ── Формат вывода результатов ──────────────────────────────────────────────────
# OUTPUT_FORMAT: table (новый Excel с таблицей результатов) | annotated (добавить столбцы в исходный Excel)
OUTPUT_FORMAT=table
# OUTPUT_FILE_SUFFIX: суффикс для нового файла результатов (используется при OUTPUT_FORMAT=table)
OUTPUT_FILE_SUFFIX=_результаты

# ── PROMPT ─────────────────────────────────────────────────────────────────────
AI_ROLE=Ты — опытный специалист по страхованию. Твоя задача — точно сопоставить требования клиента с нормативными программами страхования и подготовить структурированный ответ.

AI_PROMPT_TEMPLATE={role}\n\n## НОРМАТИВНАЯ БАЗА (ПРОГРАММЫ СТРАХОВАНИЯ):\n{normative_base}\n\n## ПРИМЕРЫ ЭТАЛОННЫХ ОТВЕТОВ:\n{examples}\n\n## ЗАПРОС КЛИЕНТА:\n{source_text}\n\n## ЗАДАЧА:\n1. Из нормативной базы выбери программу страхования, наиболее соответствующую требованиям клиента.\n2. Для КАЖДОЙ строки из таблицы запроса клиента создай ровно одну строку в таблице ответа.\n   ВАЖНО: не объединяй строки, не пропускай строки, не добавляй лишние строки.\n   Количество строк в ответе должно строго совпадать с количеством строк в запросе.\n3. Для каждой строки укажи статус покрытия в выбранной программе:\n   - Есть — требование полностью покрывается программой\n   - Нет — требование отсутствует в программе\n   - Частично — требование покрывается частично (поясни в комментарии)\n4. Оформи ответ СРАЗУ в виде таблицы (без вводного текста и преамбулы) со столбцами:\n   | Требование клиента | Покрытие по программе | Статус | Комментарий |\n5. После таблицы добавь краткое резюме: выбранная программа, ключевые расхождения и рекомендации.\n\n## ОТВЕТ (начни сразу с таблицы):

# ── PROMPT: сверка деклараций с ген. полисом (cargo) ───────────────────────────
# Шаг 1: извлечение пунктов из ОДНОГО документа (ген.полис или один ДС)
MATRIX_AI_ROLE=Ты — специалист по анализу генеральных полисов страхования грузов и дополнительных соглашений к ним. Документы могут быть на русском, английском или на обоих языках одновременно.

MATRIX_PROMPT_TEMPLATE={role}\n\n## ДОКУМЕНТ:\n{source_text}\n\n## ЗАДАЧА:\nИзвлеки из документа все пункты, которые могут понадобиться при сверке деклараций (объект страхования, маршруты, лимиты, франшиза, порядок уведомления и т.п.). В колонке «Пункт» ВСЕГДА указывай номер пункта первым (например «9. Объект страхования»), даже если он неочевиден — по номеру пункты сопоставляются между ген.полисом и ДС. Оформи ответ СРАЗУ в виде таблицы (без вводного текста):\n| Пункт (номер/название) | Актуальный текст/значение | Комментарий |\n|---|---|---|\n\n## ОТВЕТ:

# Шаг 2: сверка одной декларации (или одной строки мультистрочной декларации)
# с итоговой матрицей актуальных правил
RECONCILIATION_AI_ROLE=Ты — специалист по сверке деклараций на перевозку груза с условиями генерального полиса страхования. Декларации и полис могут быть на русском, английском или на обоих языках одновременно.

RECONCILIATION_PROMPT_TEMPLATE={role}\n\n## ЛОГИКА СВЕРКИ (какие поля с какими пунктами сопоставлять):\n{reconciliation_logic}\n\n## МАТРИЦА АКТУАЛЬНЫХ ПРАВИЛ ПОЛИСА:\n{rules_matrix}\n\n## ОСОБЫЕ УСЛОВИЯ:\n{special_conditions}\n\n## ДЕКЛАРАЦИЯ:\n{source_text}\n\n## ЗАДАЧА:\nСверь каждое значимое поле декларации с соответствующим пунктом матрицы актуальных правил. Оформи ответ СРАЗУ в виде таблицы (без вводного текста):\n| Наименование поля в декларации | С каким пунктом Ген. полиса сверено | Результат проверки | Комментарий по сверке |\n|---|---|---|---|\nВ столбце «Результат проверки» указывай строго одно из значений: совпадает / не совпадает / не знаю.\n\n## ОТВЕТ:
